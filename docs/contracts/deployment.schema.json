{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleet deployment v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1
    },
    "release_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "environment": {
      "enum": [
        "dev-macmini",
        "production-macmini",
        "production-vps"
      ]
    },
    "owner": {
      "enum": [
        "devops",
        "op-pro"
      ]
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runtime_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "rolled_back"
      ]
    },
    "executor_run": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "health": {
      "enum": [
        "passed",
        "failed",
        "unknown"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url",
          "description"
        ]
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "deployment_id",
    "release_id",
    "repository",
    "environment",
    "owner",
    "source_sha",
    "runtime_sha",
    "status",
    "executor_run",
    "health",
    "evidence",
    "completed_at"
  ]
}
