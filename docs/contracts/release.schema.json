{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleet release v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "environment": {
      "enum": [
        "production-macmini",
        "production-vps"
      ]
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dev_verified_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_pr": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "digest",
        "platform"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "reference",
        "scope_id",
        "actor",
        "approved_at"
      ]
    },
    "acceptance_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url",
          "description"
        ]
      }
    },
    "migration_plan": {
      "type": "string",
      "minLength": 1
    },
    "config_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "backup_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url",
          "description"
        ]
      }
    },
    "rollback_limits": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "repository",
    "environment",
    "source_sha",
    "dev_verified_sha",
    "release_pr",
    "artifact",
    "approval",
    "acceptance_evidence",
    "migration_plan",
    "config_references",
    "backup_evidence",
    "rollback_limits"
  ]
}
