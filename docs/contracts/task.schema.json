{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleet task v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "coding"
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_branch": {
      "const": "main"
    },
    "branch": {
      "type": "string",
      "pattern": "^(agent/issue-[1-9][0-9]*-|codex/|claude/)[A-Za-z0-9._/-]+$"
    },
    "engine": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "allowed_paths",
        "excluded_paths",
        "out_of_scope"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "criterion",
          "verification"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "reference",
        "scope_id",
        "actor",
        "approved_at"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "max_fix_rounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "daily_budget_reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "max_minutes",
        "max_fix_rounds",
        "max_cost_usd",
        "daily_budget_reference"
      ]
    },
    "target_environment": {
      "const": "dev-macmini"
    },
    "receipt_location": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "repository",
    "task_id",
    "kind",
    "issue_number",
    "base_sha",
    "base_branch",
    "branch",
    "engine",
    "goal",
    "scope",
    "acceptance_criteria",
    "dependencies",
    "approval",
    "limits",
    "target_environment",
    "receipt_location"
  ]
}
