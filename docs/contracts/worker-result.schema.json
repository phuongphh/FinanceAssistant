{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleet worker-result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "review_ready",
        "blocked",
        "test_failed",
        "timeout",
        "auth_failed",
        "rate_limited",
        "infra_failed",
        "scope_violation",
        "cancelled"
      ]
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "url",
              "description"
            ]
          }
        }
      },
      "required": [
        "status",
        "evidence"
      ]
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "next_step": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "repository",
    "task_id",
    "run_id",
    "engine",
    "session_id",
    "status",
    "base_sha",
    "head_sha",
    "changed_files",
    "gates",
    "checkpoint",
    "next_step"
  ]
}
